# Supabase Frontend Configuration (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Sentry Error Reporting & Performance Monitoring (Optional, see docs/ERROR_TRACKING_AND_MONITORING.md)
# JobPulse has a built-in default DSN in src/lib/sentry.ts; no .env variable is required.
# Specify VITE_SENTRY_DSN only if overriding the error reporting destination with a custom project.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

