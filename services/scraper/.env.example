# Supabase Connection Settings for Scraper
# Note: Use the secret service role key so the scraper can write to tables with RLS enabled.
# NEVER commit your real .env file to git or expose the service role key publicly.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...


# Optional: enables bounded post-scrape employer office research and location verification.
GEOAPIFY_API_KEY=

# Optional: board-discovery input for `tools/discover_boards.py --source freehire`.
# The scrape pipeline never calls this; it is only read by that optional tool, and the
# public endpoint needs no key. Leave unset to use the default, or point it elsewhere.
# FREEHIRE_API_URL=https://freehire.me/api/v1

# JobsIreland listing/detail requests are sequential, separated by this many seconds (minimum 1).
JOBSIRELAND_REQUEST_DELAY_SECONDS=3
