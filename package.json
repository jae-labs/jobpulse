{
  "name": "jobpulse-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "dev:hosted": "node scripts/prepare-browser-model.mjs && vite",
    "build": "node scripts/prepare-browser-model.mjs && tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "prepare:browser-model": "node scripts/prepare-browser-model.mjs",
    "storybook": "pnpm --filter @jae-labs/ui storybook",
    "build-storybook": "pnpm --filter @jae-labs/ui build-storybook",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "oxlint && bash scripts/check-design-system-boundary.sh && node scripts/check-ds-utilities.mjs && node scripts/check-chart-tooltip-copy.mjs && node scripts/check-tenant-boundaries.mjs && node scripts/check-doc-links.mjs && node scripts/check-translation-keys.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p packages/ui/tsconfig.json --noEmit",
    "test": "vitest run --exclude 'packages/ui/**' && pnpm --filter @jae-labs/ui test:unit && node --test scripts/*.node-test.mjs",
    "test:coverage": "vitest run --coverage --exclude 'packages/ui/**' && pnpm --filter @jae-labs/ui test:unit && node --test scripts/*.node-test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "test:tenant-lint": "node --test scripts/check-tenant-boundaries.node-test.mjs && node scripts/check-tenant-boundaries.mjs",
    "db:test": "node scripts/test-database.mjs",
    "db:test:tenancy": "node scripts/test-database.mjs --tenancy",
    "db:migration": "supabase migration new",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:diff": "supabase db diff --linked --schema public",
    "db:push": "supabase db push",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:test:account-deletion": "node scripts/test-account-deletion.mjs",
    "test:ui": "pnpm --filter @jae-labs/ui test:browser",
    "test:ui:visual": "node scripts/test-ui-visual.mjs",
    "test:ui:visual:update": "node scripts/test-ui-visual.mjs --update",
    "db:test:crawl": "node scripts/test-crawl-concurrency.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "4.3.1",
    "@jae-labs/ui": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@sentry/react": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "cmdk": "^1.1.1",
    "i18next": "^26.5.10",
    "i18next-browser-languagedetector": "^8.2.2",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "oxlint": "^1.89.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
