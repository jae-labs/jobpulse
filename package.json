{
  "name": "jobpulse-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:hosted": "vite",
    "stop": "npm run db:stop",
    "build": "tsc -b && vite build",
    "storybook": "pnpm --filter @jae-labs/ui storybook",
    "build-storybook": "pnpm --filter @jae-labs/ui build-storybook",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "oxlint && bash scripts/check-design-system-boundary.sh && node scripts/check-chart-tooltip-copy.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p packages/ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "db:migration": "supabase migration new",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:diff": "supabase db diff --linked --schema public",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts && supabase gen types --lang=python --local > services/scraper/database/models.py && (cd services/scraper && uv run --locked ruff format database/models.py)"
  },
  "dependencies": {
    "@jae-labs/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "^11.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^28.1.0",
    "lefthook": "^2.1.9",
    "oxlint": "^1.79.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
